# Šiame faile tik pavyzdžiai. Tikrus raktus įrašykite per Supabase Edge Function Secrets.
PUBLIC_SITE_URL=https://atminimokodas.lt/
AUTOMATION_SECRET=PAKEISKITE_ILGU_ATSITIKTINIU_RAKTU
# Administratoriaus ir Reply-To adresas gali būti atminimokodas@gmail.com.
ADMIN_EMAIL=atminimokodas@gmail.com
# Siuntėjas turi būti iš Resend patvirtinto domeno; Gmail adreso čia nenaudokite.
EMAIL_FROM=Atminimas <noreply@jusu-domenas.lt>
RESEND_API_KEY=re_...
# Paysera Checkout Modern. Optional when the server-only Supabase Vault entry
# paysera_checkout_modern contains client_id, client_secret and project_id.
PAYSERA_CLIENT_ID=
PAYSERA_CLIENT_SECRET=
PAYSERA_MODERN_PROJECT_ID=
# Legacy Checkout Classic, only when handling previously created Classic payments.
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=
# Classic only: 1 for sandbox, 0 for live. Modern Test Mode is set in Paysera.
# Sandbox callbacks never mark services paid.
PAYSERA_TEST=1
# Retained only for previously started Stripe payments and historical callbacks.
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
SHIPMENT_ADAPTER_URL=https://shipping-adapter.example.com/v1/shipments
SHIPMENT_ADAPTER_SECRET=replace-with-long-random-secret
